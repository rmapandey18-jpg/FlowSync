# Simple local setup
DATABASE_URL=sqlite+aiosqlite:///./flowsync.db

# Security
JWT_SECRET_KEY=change-this-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOWED_HOSTS=*

# Runtime tuning
TRAFFIC_UPDATE_INTERVAL=5
PREDICTION_INTERVAL=60
LOG_LEVEL=INFO
